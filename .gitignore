# 运行时产物（不要提交）
pins.json
edits.json
Rplots.pdf
rt2.json
*.tmp[0-9]*
tests/out/
tests/_out.txt
tests/_run_out.txt
tests/_run_err.txt
*.log

# 工具/编辑器内部状态
.zcode/

# 前端
frontend/node_modules/
_dist_check/

# Positron 扩展（只提交源码，不提交依赖与产物）
positron-ext/node_modules/
positron-ext/out/
positron-ext/*.vsix
.positron-test-ext/
.positron-test-data/

# 系统
Thumbs.db
.DS_Store
# 用户上传数据（落盘，随项目恢复）
userdata/

# 统计代码示例的默认导出文件名（tests 运行时会生成）
table1.docx
table1.xlsx
stats-summary.R

# 扩展开关状态（运行时）
extensions.json

# 拼图/图库生成的面板预览图与数据快照（运行时产物）
# 新布局把它们放在 pins/ 子目录；保留根目录规则以兼容旧数据
/P[0-9]*.png
/P[0-9]*.rds
/pins/
